# Download the pinned JMX Exporter in a separate stage. The agent is optional at runtime.
FROM eclipse-temurin:17 AS jmx-exporter
ARG JMX_EXPORTER_VERSION=1.7.0
ARG JMX_EXPORTER_SHA256=0ad843261c567d1924a017d542e14c40f2afff523d940c25ee000742fde4b3a9
RUN apt-get update && \
  apt-get install -y --no-install-recommends ca-certificates curl && \
  mkdir -p /opt/jmx-exporter && \
  curl --fail --location --silent --show-error --retry 3 \
    "https://github.com/prometheus/jmx_exporter/releases/download/${JMX_EXPORTER_VERSION}/jmx_prometheus_javaagent-${JMX_EXPORTER_VERSION}.jar" \
    --output /opt/jmx-exporter/jmx_prometheus_javaagent.jar && \
  echo "${JMX_EXPORTER_SHA256}  /opt/jmx-exporter/jmx_prometheus_javaagent.jar" | sha256sum --check --status

FROM eclipse-temurin:17 AS builder

RUN apt-get update && apt-get upgrade -y && \
  mkdir /indigo-iam
WORKDIR /indigo-iam
COPY iam-login-service.war /indigo-iam/
RUN java -Djarmode=layertools -jar iam-login-service.war extract

FROM eclipse-temurin:17

RUN groupadd --gid 10001 iam && \
  useradd --uid 10001 \
          --gid iam \
          --no-log-init \
          --create-home \
          --home-dir /home/iam \
          --shell /usr/sbin/nologin \
          iam

RUN mkdir /indigo-iam
WORKDIR /indigo-iam
COPY --from=builder indigo-iam/dependencies/ ./
COPY --from=builder indigo-iam/spring-boot-loader/ ./
COPY --from=builder indigo-iam/snapshot-dependencies/ ./
COPY --from=builder indigo-iam/application/ ./
# Read-only agent files; not loaded unless -javaagent is explicitly provided.
COPY --from=jmx-exporter /opt/jmx-exporter/jmx_prometheus_javaagent.jar /opt/jmx-exporter/jmx_prometheus_javaagent.jar
COPY jmx-exporter.yaml /opt/jmx-exporter/config.yaml

RUN apt-get update && apt-get upgrade -y && \
  apt-get install -y zip && \
  zip -d WEB-INF/lib/angular-ui-bootstrap-2.5.6.jar META-INF/resources/webjars/angular-ui-bootstrap/2.5.6/dist/.DS_Store

RUN if [ -f WEB-INF/classes/keystore.jwks ]; then \
    echo "ERROR: keystore.jwks should not be present in the image"; \
    exit 1; \
  fi

# Keep application files owned by root; IAM only needs read access.
USER 10001:10001

CMD ["/bin/sh", "-c", "exec java ${IAM_JAVA_OPTS} org.springframework.boot.loader.WarLauncher"]
